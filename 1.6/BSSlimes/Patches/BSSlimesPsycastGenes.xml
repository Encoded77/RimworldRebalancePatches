<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="RebalancePatches.PatchOperationIfEnabled">
    <settingKey>vpebiotech.xenotypes</settingKey>
    <operations>
      <li Class="RebalancePatches.PatchOperationFindModById">
        <mods>
          <li>danzen.vpe.biotechintegration</li>
        </mods>
        <match Class="PatchOperationSequence">
          <operations>
            <li Class="PatchOperationAdd">
              <xpath>Defs/XenotypeDef[defName="BS_EmperorSlime"]/genes</xpath>
              <value>
                <li>Gene_Harmonist</li>
              </value>
            </li>
            <li Class="PatchOperationAdd">
              <xpath>Defs/XenotypeDef[defName="BS_FrostSlime" or defName="BS_FrostSlimeGiant" or defName="BS_BananaSplitSlime" or defName="BS_BananaSplitSlimeGiant"]/genes</xpath>
              <value>
                <li>Gene_Frostshaper</li>
              </value>
            </li>
            <li Class="PatchOperationAdd">
              <xpath>Defs/XenotypeDef[defName="BS_LavaSlime" or defName="BS_LavaSlimeGiant"]/genes</xpath>
              <value>
                <li>Gene_Conflagrator</li>
              </value>
            </li>
          </operations>
        </match>
      </li>
    </operations>
  </Operation>
</Patch>
