<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="RebalancePatches.PatchOperationIfEnabled">
    <settingKey>geneconflicts.dodge</settingKey>
    <operations>
      <li Class="PatchOperationConditional">
        <xpath>Defs/GeneDef[defName="AgileStriker"]/exclusionTags</xpath>
        <match Class="PatchOperationAdd">
          <xpath>Defs/GeneDef[defName="AgileStriker"]/exclusionTags</xpath>
          <value><li>MeleeDodge</li></value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/GeneDef[defName="AgileStriker"]</xpath>
          <value><exclusionTags><li>MeleeDodge</li></exclusionTags></value>
        </nomatch>
      </li>
    </operations>
  </Operation>

  <Operation Class="RebalancePatches.PatchOperationIfEnabled">
    <settingKey>odyssey.vacuumtrims</settingKey>
    <operations>
      <li Class="RebalancePatches.PatchOperationFindModById">
        <mods>
          <li>vanillaexpanded.gravship</li>
        </mods>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="Apparel_Shocksuit"]/equippedStatOffsets/VacuumResistance</xpath>
          <value><VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.32</VacuumResistance></value>
        </match>
      </li>
    </operations>
  </Operation>

</Patch>
