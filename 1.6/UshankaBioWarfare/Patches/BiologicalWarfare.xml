<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="RebalancePatches.PatchOperationIfEnabled">
    <settingKey>biowarfare.researchtree</settingKey>
    <operations>

      <li Class="PatchOperationAdd">
        <xpath>Defs</xpath>
        <value>

          <ResearchProjectDef ParentName="USH_BiologicalProjectBase">
            <defName>RBP_USH_Weaponisation</defName>
            <label>pathogen weaponisation</label>
            <description>Stabilise cultured pathogens for delivery: the barrels, shells, grenades, missiles and vent systems that carry a disease to someone else's colony. Covers every strain your incubators can grow.</description>
            <baseCost>1200</baseCost>
            <prerequisites>
              <li>USH_PathogenProductionRes</li>
            </prerequisites>
            <researchViewX>1.00</researchViewX>
            <researchViewY>1.40</researchViewY>
          </ResearchProjectDef>

          <ResearchProjectDef ParentName="USH_DiseaseVaccineResBase">
            <defName>RBP_USH_Antibodies</defName>
            <label>broad-spectrum antibodies</label>
            <description>Culture antibodies against the whole pathogen family at once, rather than chasing one strain at a time. Must be studied at the antigens analyzer with a disease sample loaded; any sample will do, and the result protects against all of them.</description>
            <baseCost>1500</baseCost>
            <prerequisites Inherit="False">
              <li>USH_PathogenProductionRes</li>
            </prerequisites>
            <researchViewX>1.00</researchViewX>
            <researchViewY>2.80</researchViewY>
          </ResearchProjectDef>

        </value>
      </li>

      <li Class="PatchOperationReplace">
        <xpath>Defs//researchPrerequisites/li[contains(text(),"OperationRes")]</xpath>
        <value>
          <li>RBP_USH_Weaponisation</li>
        </value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs//researchPrerequisite[contains(text(),"OperationRes")]</xpath>
        <value>
          <researchPrerequisite>RBP_USH_Weaponisation</researchPrerequisite>
        </value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs//researchProjectsDefsToFormat/li[contains(text(),"OperationRes")]</xpath>
        <value>
          <li>RBP_USH_Weaponisation</li>
        </value>
      </li>

      <li Class="PatchOperationReplace">
        <xpath>Defs//researchPrerequisites/li[contains(text(),"VaccineRes")]</xpath>
        <value>
          <li>RBP_USH_Antibodies</li>
        </value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs//researchPrerequisite[contains(text(),"VaccineRes")]</xpath>
        <value>
          <researchPrerequisite>RBP_USH_Antibodies</researchPrerequisite>
        </value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs//researchProjectsDefsToFormat/li[contains(text(),"VaccineRes")]</xpath>
        <value>
          <li>RBP_USH_Antibodies</li>
        </value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs//vaccineResProjectDef[contains(text(),"VaccineRes")]</xpath>
        <value>
          <vaccineResProjectDef>RBP_USH_Antibodies</vaccineResProjectDef>
        </value>
      </li>

      <li Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="USH_AntigensAnalyzer"]/researchPrerequisites</xpath>
        <value>
          <researchPrerequisites>
            <li>USH_PathogenProductionRes</li>
          </researchPrerequisites>
        </value>
      </li>

      <li Class="PatchOperationRemove">
        <xpath>Defs/ResearchProjectDef[defName="USH_FluOperationRes" or defName="USH_SleepingSicknessOperationRes"
          or defName="USH_MalariaOperationRes" or defName="USH_ScariaOperationRes"
          or defName="USH_PlagueOperationRes" or defName="USH_NecroaOperationRes"
          or defName="USH_FleshBreakerOperationRes"
          or defName="USH_FluVaccineRes" or defName="USH_SleepingSicknessVaccineRes"
          or defName="USH_MalariaVaccineRes" or defName="USH_ScariaVaccineRes"
          or defName="USH_PlagueVaccineRes" or defName="USH_NecroaVaccineRes"
          or defName="USH_InfectionVaccineRes"]</xpath>
      </li>

    </operations>
  </Operation>

</Patch>
