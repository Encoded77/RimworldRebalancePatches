<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="RebalancePatches.PatchOperationIfEnabled">
    <settingKey>autohydroponics.costlier</settingKey>
    <operations>
      <li Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="AutoHydroponic"]/costList</xpath>
        <value><costList><Steel>1000</Steel><ComponentIndustrial>12</ComponentIndustrial><ComponentSpacer>4</ComponentSpacer></costList></value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="AutoHydroponic"]/comps/li[@Class="CompProperties_Power"]/basePowerConsumption</xpath>
        <value><basePowerConsumption>2000</basePowerConsumption></value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="SmallAutoHydroponic"]/costList</xpath>
        <value><costList><Steel>500</Steel><ComponentIndustrial>8</ComponentIndustrial><ComponentSpacer>2</ComponentSpacer></costList></value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="SmallAutoHydroponic"]/comps/li[@Class="CompProperties_Power"]/basePowerConsumption</xpath>
        <value><basePowerConsumption>1000</basePowerConsumption></value>
      </li>
    </operations>
  </Operation>

</Patch>
