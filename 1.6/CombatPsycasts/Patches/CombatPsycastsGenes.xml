<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="RebalancePatches.PatchOperationIfEnabled">
    <settingKey>vpebiotech.pathgenes</settingKey>
    <operations>
      <li Class="RebalancePatches.PatchOperationFindModById">
        <mods>
          <li>danzen.vpe.biotechintegration</li>
        </mods>
        <match Class="PatchOperationSequence">
          <operations>
            <li Class="PatchOperationAdd">
              <xpath>Defs</xpath>
              <value>
                <GeneDef ParentName="GenePsycastBase">
                  <defName>RBP_Gene_Kinecticist</defName>
                  <label>kinecticist</label>
                  <labelShortAdj>Kinecticist</labelShortAdj>
                  <description>Carriers of this gene are able to learn the Kinecticist psycaster path. Engineered shock troops such as hussars and Uredde carry this natural endogene.</description>
                  <iconPath>RBP/GeneIcons/RBP_Gene_Kinecticist</iconPath>
                  <displayOrderInCategory>536</displayOrderInCategory>
                  <marketValueFactor>3</marketValueFactor>
                </GeneDef>
              </value>
            </li>
            <li Class="PatchOperationAdd">
              <xpath>Defs/VanillaPsycastsExpanded.PsycasterPathDef[defName="CP_Combat"]</xpath>
              <value>
                <lockedReason>Kinecticist gene</lockedReason>
                <requiredGene>RBP_Gene_Kinecticist</requiredGene>
              </value>
            </li>
          </operations>
        </match>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>Defs/GeneDef[defName="RBP_Gene_Kinecticist"]</xpath>
        <match Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="RBP_GN_Psycast"]</xpath>
          <match Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="RBP_GN_Psycast"]/comps/li[@Class="GeneExtractorTiers.CompProperties_GeneNode"]/geneList</xpath>
            <value>
              <li>RBP_Gene_Kinecticist</li>
            </value>
          </match>
        </match>
      </li>
    </operations>
  </Operation>
  <Operation Class="RebalancePatches.PatchOperationIfEnabled">
    <settingKey>vpebiotech.xenotypes</settingKey>
    <operations>
      <li Class="PatchOperationConditional">
        <xpath>Defs/GeneDef[defName="RBP_Gene_Kinecticist"]</xpath>
        <match Class="PatchOperationAdd">
          <xpath>Defs/XenotypeDef[defName="Hussar" or defName="Uredd"]/genes</xpath>
          <value>
            <li>RBP_Gene_Kinecticist</li>
          </value>
        </match>
      </li>
    </operations>
  </Operation>
</Patch>
