<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="RebalancePatches.PatchOperationIfEnabled">
    <settingKey>vpebiotech.xenotypes</settingKey>
    <operations>
      <li Class="RebalancePatches.PatchOperationFindModById">
        <mods>
          <li>danzen.vpe.biotechintegration</li>
        </mods>
        <match Class="PatchOperationSequence">
          <operations>
            <li Class="PatchOperationAdd">
              <xpath>Defs/XenotypeDef[defName="BS_Kitsune"]/genes</xpath>
              <value>
                <li MayRequire="hautarche.hautstraits">HVT_Gene_Mindbender</li>
                <li>Gene_Conflagrator</li>
                <li>Gene_Puppeteer</li>
              </value>
            </li>
            <li Class="PatchOperationAdd">
              <xpath>Defs/XenotypeDef[defName="BS_Nekomata"]/genes</xpath>
              <value>
                <li>Gene_Necropath</li>
              </value>
            </li>
            <li Class="PatchOperationAdd">
              <xpath>Defs/XenotypeDef[defName="BS_RedOni" or defName="BS_GreatRedOni"]/genes</xpath>
              <value>
                <li>Gene_Conflagrator</li>
              </value>
            </li>
            <li Class="PatchOperationAdd">
              <xpath>Defs/XenotypeDef[defName="BS_BlueOni" or defName="BS_GreatBlueOni"]/genes</xpath>
              <value>
                <li>Gene_Staticlord</li>
              </value>
            </li>
            <li Class="PatchOperationAdd">
              <xpath>Defs/XenotypeDef[defName="BS_GreatRedOni" or defName="BS_GreatBlueOni"]/genes</xpath>
              <value>
                <li>Gene_Warlord</li>
              </value>
            </li>
          </operations>
        </match>
      </li>
    </operations>
  </Operation>
</Patch>
