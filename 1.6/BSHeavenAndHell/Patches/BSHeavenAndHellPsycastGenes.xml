<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="RebalancePatches.PatchOperationIfEnabled">
    <settingKey>vpebiotech.xenotypes</settingKey>
    <operations>
      <li Class="RebalancePatches.PatchOperationFindModById">
        <mods>
          <li>danzen.vpe.biotechintegration</li>
        </mods>
        <match Class="PatchOperationSequence">
          <operations>
            <li Class="PatchOperationAdd">
              <xpath>Defs/XenotypeDef[defName="BS_Authority"]/genes</xpath>
              <value>
                <li>Gene_Warlord</li>
                <li>Gene_Protector</li>
                <li>Gene_Archon</li>
              </value>
            </li>
            <li Class="PatchOperationAdd">
              <xpath>Defs/XenotypeDef[defName="BS_Malakim"]/genes</xpath>
              <value>
                <li>Gene_Empath</li>
                <li>Gene_Harmonist</li>
                <li>Gene_Skipmaster</li>
              </value>
            </li>
            <li Class="PatchOperationAdd">
              <xpath>Defs/XenotypeDef[defName="BS_Grigori"]/genes</xpath>
              <value>
                <li MayRequire="hautarche.hautstraits">HVT_Gene_Mindbender</li>
              </value>
            </li>
            <li Class="PatchOperationAdd">
              <xpath>Defs/XenotypeDef[defName="BS_Nephilim"]/genes</xpath>
              <value>
                <li>Gene_Warlord</li>
              </value>
            </li>
            <li Class="PatchOperationAdd">
              <xpath>Defs/XenotypeDef[defName="BS_Lilim"]/genes</xpath>
              <value>
                <li>Gene_Nightstalker</li>
                <li>Gene_Puppeteer</li>
              </value>
            </li>
            <li Class="PatchOperationAdd">
              <xpath>Defs/XenotypeDef[defName="BS_Satan"]/genes</xpath>
              <value>
                <li>Gene_Conflagrator</li>
                <li>Gene_Warlord</li>
                <li>Gene_Archon</li>
              </value>
            </li>
          </operations>
        </match>
      </li>
    </operations>
  </Operation>
</Patch>
